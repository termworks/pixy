oslo.prompt.left = {
  command = "pixy",
  args = { "render", "prompt.left", "--target=ansi", "--palette",
           "--set", "status=$status", "--set", "duration_ms=$duration_ms",
           "--set", "jobs=$jobs", "--set", "language=$language",
           "--set", "vimode=$vimode" },
  timeout_ms = 10,
  async = true,
}

oslo.prompt.right = {
  command = "pixy",
  args = { "render", "prompt.right", "--target=ansi", "--palette",
           "--set", "status=$status", "--set", "language=$language",
           "--set", "vimode=$vimode" },
  timeout_ms = 10,
  async = true,
}
